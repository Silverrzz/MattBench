OPENBENCH_DEBUG=0
OPENBENCH_SECRET_KEY=
OPENBENCH_ALLOWED_HOSTS=training.example.com
OPENBENCH_CSRF_ORIGINS=https://training.example.com
OPENBENCH_TRUST_PROXY=1
OPENBENCH_WATCHER_LOCK=/var/lib/openbench/openbench_watchers.lock
OPENBENCH_DATABASE_CONFIG=/etc/openbench/database.json
OPENBENCH_STATIC_ROOT=/var/lib/openbench/static
OPENBENCH_MEDIA_ROOT=/var/lib/openbench/media
MATTBENCH_TRAINING_ROOT=/var/lib/openbench/training
MATTBENCH_REPLICA_ROOT=/var/lib/openbench/replica
MATTBENCH_CREDENTIAL_KEY_FILE=/etc/openbench/credential.key
HF_HOME=/var/lib/openbench/huggingface
